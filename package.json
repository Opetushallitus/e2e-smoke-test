{
  "name": "e2e-smoke-test",
  "version": "0.0.1",
  "description": "E2e and smoke tests",
  "engines": {
    "npm": ">=8.5.0",
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "test": "playwright test",
    "test:untuva": "DOMAIN='https://untuvaopintopolku.fi' playwright test",
    "test:hahtuva": "DOMAIN='https://hahtuvaopintopolku.fi' playwright test",
    "test:qa": "DOMAIN='https://testiopintopolku.fi' playwright test",
    "test:prod": "DOMAIN='https://opintopolku.fi' playwright test",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@playwright/test": "1.61.1",
    "axios": "1.18.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-love": "154.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.1.1",
    "typescript": "6.0.3"
  }
}
